NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
# SUPABASE_SECRET_KEY is only needed in server-side Next.js route handlers.
# Never prefix it with NEXT_PUBLIC_ — it bypasses all Row Level Security.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# SSO (optional — leave unset to use email/password only)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SSO_TYPE         — "oauth" or "saml"
# NEXT_PUBLIC_SSO_BUTTON_LABEL — text shown on the SSO button, e.g. "Sign in with Okta"
# NEXT_PUBLIC_SSO_EXCLUSIVE    — set to "true" to hide the email/password form entirely
#
# For OAuth/OIDC (NEXT_PUBLIC_SSO_TYPE=oauth):
#   Configure Okta as a custom OIDC provider in your self-hosted Supabase
#   GoTrue config, then set the provider name you chose:
# NEXT_PUBLIC_SSO_OAUTH_PROVIDER=okta
#
# For SAML (NEXT_PUBLIC_SSO_TYPE=saml):
#   Add your Okta SAML metadata to Supabase via the admin API or dashboard.
#   Supabase returns a UUID for the provider — set that here:
# NEXT_PUBLIC_SSO_SAML_PROVIDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Examples for an SSO-only internal deployment:
# NEXT_PUBLIC_SSO_TYPE=saml
# NEXT_PUBLIC_SSO_BUTTON_LABEL=Sign in with Okta
# NEXT_PUBLIC_SSO_SAML_PROVIDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_SSO_EXCLUSIVE=true
