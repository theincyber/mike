PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# ---------------------------------------------------------------------------
# Database / Auth
# ---------------------------------------------------------------------------
# For full data sovereignty run self-hosted Supabase (open source, Docker
# Compose) on your internal server. Change only the URL — all code stays the
# same. See: https://supabase.com/docs/guides/self-hosting/docker
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Defaults to Cloudflare R2. For internal deployments point these at a
# self-hosted MinIO instance instead — the S3-compatible SDK works unchanged.
# MinIO quick-start: https://min.io/docs/minio/linux/index.html
# Example internal endpoint: http://minio.internal:9000
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Restrict which LLM providers the backend will accept requests for.
# Comma-separated list: openai, gemini, claude
# Unset = all providers accepted. Example (Azure OpenAI only):
# ENABLED_PROVIDERS=openai

# --- Gemini (Google) ---
GEMINI_API_KEY=your-gemini-key

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-key

# --- OpenAI ---
# Option A: Standard OpenAI (api.openai.com) — set OPENAI_API_KEY only.
# Option B: Azure OpenAI (your own Azure tenancy) — set all four AZURE_*
#   variables. Data stays within your Azure subscription under Microsoft's
#   enterprise data processing agreement. OPENAI_API_KEY is ignored when
#   Azure is configured; use AZURE_OPENAI_API_KEY instead.
#
#   In Azure Portal: create an Azure OpenAI resource, deploy a model (e.g.
#   gpt-4o), note the endpoint URL, deployment name, and API key.
#   AZURE_OPENAI_DEPLOYMENT must match the deployment name you gave it —
#   not the underlying model name.
OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret
# Stable salt for scrypt key derivation. Generate once with: openssl rand -hex 32
# Never change this after deployment — doing so invalidates all stored API keys.
USER_API_KEYS_KDF_SALT=replace-with-a-random-32-byte-hex-string
